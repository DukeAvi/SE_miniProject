DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,bbms.example.test
DJANGO_TIME_ZONE=UTC
BLOOD_BANK_TIME_ZONE=Asia/Kolkata
DONATION_SLOT_CAPACITY=10
DEFAULT_STOCK_THRESHOLD=5
BACKUP_RETENTION_DAYS=7
# Enable Compose profile "backup" only after configuring a dedicated S3 bucket, a generated
# 32-byte URL-safe base64 encryption key, and an HTTPS alert webhook. Never reuse a source key.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_PREFIX=bbms-backups
BACKUP_ENCRYPTION_KEY=
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_WEBHOOK_BEARER_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
INVENTORY_EXPIRY_BATCH_SIZE=100
CELERY_BROKER_URL=redis://localhost:6379/0
SESSION_COOKIE_AGE=1200
LOGIN_THROTTLE_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=900
FAILED_LOGIN_ALERT_THRESHOLD=20
FAILED_LOGIN_ALERT_WINDOW_SECONDS=60

POSTGRES_DB=bbms
POSTGRES_USER=bbms
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Local development only. Use the secure Compose overlay and verify-full in deployments.
POSTGRES_SSLMODE=disable
POSTGRES_SSLROOTCERT=
BBMS_PUBLIC_HOSTNAME=bbms.example.test
BBMS_TLS_DIR=/secure/path/public-tls
POSTGRES_TLS_DIR=/secure/path/postgres-tls

# Local classroom demo only. Tests inject a deterministic mock adapter.
NOTIFICATION_PROVIDER=console
NOTIFICATION_PENDING_ALERT_THRESHOLD=100
NOTIFICATION_FAILURE_RATE_ALERT_PERCENT=10

# Monitoring deployment placeholders. Replace locally; never commit live values.
BBMS_PUBLIC_HEALTH_URL=https://bbms.example.test/healthz
BBMS_ALERT_WEBHOOK_URL=https://alerts.example.test/webhook
BBMS_ALERT_WEBHOOK_BEARER_TOKEN=
BBMS_APP_METRICS_URL=https://bbms.internal.example.test/metrics
BBMS_APP_METRICS_BEARER_TOKEN=replace-with-a-random-32-byte-or-longer-token

# For Compose deployments, include the public hostname in DJANGO_ALLOWED_HOSTS.
